# CapSpend Arc — Environment Variables Example

# Server
PORT=3002

# Circle Developer-Controlled Wallets
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY_HERE
CIRCLE_ENTITY_SECRET=YOUR_CIRCLE_ENTITY_SECRET_HEX_HERE
WALLET_ID=YOUR_CIRCLE_WALLET_ID_HERE
WALLET_ADDRESS=YOUR_CIRCLE_WALLET_ADDRESS_HERE

# Deployed Contract Address
SPENDING_POLICY_ADDRESS=0x040456b7c43090c5ea912826f04deb5575438b0a

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
